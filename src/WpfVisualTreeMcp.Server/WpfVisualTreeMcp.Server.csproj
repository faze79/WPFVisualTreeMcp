<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WpfVisualTreeMcp.Server</RootNamespace>
    <AssemblyName>WpfVisualTreeMcp.Server</AssemblyName>

    <!-- Package metadata -->
    <PackageId>WpfVisualTreeMcp</PackageId>
    <Version>0.12.0</Version>
    <Authors>faze79</Authors>
    <Description>MCP server for inspecting WPF application Visual Trees - enables AI agents to debug and analyze WPF UI hierarchies in real-time</Description>
    <PackageTags>mcp;wpf;visual-tree;debugging;dotnet;ai-agents</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/faze79/WpfVisualTreeMcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/faze79/WPFVisualTreeMcp</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- NuGet MCP-server / dotnet-tool packaging: install with `dotnet tool install -g
         WpfVisualTreeMcp` or run with `dnx WpfVisualTreeMcp`. McpServer package type
         makes the server discoverable in the VS / VS Code MCP catalogs. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>wpfinspect</ToolCommandName>
    <PackageType>McpServer;DotnetTool</PackageType>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!-- MCP registry manifest, required at .mcp/server.json inside the package
         for registry.modelcontextprotocol.io NuGet validation -->
    <None Include=".mcp\server.json" Pack="true" PackagePath=".mcp\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="0.4.1-preview.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.IO.Pipes" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WpfVisualTreeMcp.Shared\WpfVisualTreeMcp.Shared.csproj" />
    <ProjectReference Include="..\WpfVisualTreeMcp.Injector\WpfVisualTreeMcp.Injector.csproj" />
    <!-- Inspector is a packaged payload, not a compile-time Server dependency. -->
    <ProjectReference Include="..\WpfVisualTreeMcp.Inspector\WpfVisualTreeMcp.Inspector.csproj"
                      Condition="'$(NoBuild)' != 'true' And '$(_IsPacking)' != 'true'"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true" />
    <!--
      Build the x86 injector helper alongside Server so cross-arch injection works.
      We don't link against its output (it's a separate exe, not an assembly we
      consume); we just want MSBuild to build it before our own publish so its
      bin files are present when the payload is collected below.
    -->
    <ProjectReference Include="..\WpfVisualTreeMcp.InjectorHelper\WpfVisualTreeMcp.InjectorHelper.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      UndefineProperties="Platform;RuntimeIdentifier"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!-- Tool packing suppresses the build-only Inspector project reference. Build the -->
  <!-- two payload frameworks explicitly before collecting a first-build pack. -->
  <Target Name="BuildInspectorPayloadForPack"
          BeforeTargets="CollectInjectionPayload"
          Condition="'$(_IsPacking)' == 'true' And '$(NoBuild)' != 'true'">
    <MSBuild Projects="..\WpfVisualTreeMcp.Inspector\WpfVisualTreeMcp.Inspector.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net48" />
    <MSBuild Projects="..\WpfVisualTreeMcp.Inspector\WpfVisualTreeMcp.Inspector.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net8.0-windows" />
  </Target>

  <!-- Collect injection payloads after project references have built. Evaluation-time -->
  <!-- globs are empty on a clean publish because the Inspector output does not exist yet. -->
  <Target Name="CollectInjectionPayload">
    <ItemGroup>
      <_InjectionPayload Remove="@(_InjectionPayload)" />
      <_NetFrameworkInspectorPayload Remove="@(_NetFrameworkInspectorPayload)" />
      <_NetFrameworkInspectorPayload Include="..\WpfVisualTreeMcp.Inspector\bin\$(Configuration)\net48\*.dll" />

      <_InjectionPayload Include="..\WpfVisualTreeMcp.Bootstrapper\build\x64\Release\WpfInspectorBootstrapper.dll"
                         RelativePath="native\x64\WpfInspectorBootstrapper.dll" />
      <_InjectionPayload Include="@(_NetFrameworkInspectorPayload)"
                         RelativePath="native\x64\%(Filename)%(Extension)" />
      <_InjectionPayload Include="..\WpfVisualTreeMcp.Bootstrapper\build\Win32\Release\WpfInspectorBootstrapper.dll"
                         RelativePath="native\x86\WpfInspectorBootstrapper.dll" />
      <_InjectionPayload Include="@(_NetFrameworkInspectorPayload)"
                         RelativePath="native\x86\%(Filename)%(Extension)" />

      <_InjectionPayload Include="..\WpfVisualTreeMcp.InjectorHelper\bin\$(Configuration)\net8.0\win-x86\WpfInjectorHelper.exe"
                         RelativePath="native\x86\WpfInjectorHelper.exe" />
      <_InjectionPayload Include="..\WpfVisualTreeMcp.InjectorHelper\bin\$(Configuration)\net8.0\win-x86\WpfInjectorHelper.dll"
                         RelativePath="native\x86\WpfInjectorHelper.dll" />
      <_InjectionPayload Include="..\WpfVisualTreeMcp.InjectorHelper\bin\$(Configuration)\net8.0\win-x86\WpfInjectorHelper.runtimeconfig.json"
                         RelativePath="native\x86\WpfInjectorHelper.runtimeconfig.json" />
      <_InjectionPayload Include="..\WpfVisualTreeMcp.InjectorHelper\bin\$(Configuration)\net8.0\win-x86\WpfInjectorHelper.deps.json"
                         RelativePath="native\x86\WpfInjectorHelper.deps.json" />
      <_InjectionPayload Include="..\WpfVisualTreeMcp.InjectorHelper\bin\$(Configuration)\net8.0\win-x86\WpfVisualTreeMcp.Injector.dll"
                         RelativePath="native\x86\WpfVisualTreeMcp.Injector.dll" />

      <_InjectionPayload Include="..\WpfVisualTreeMcp.Inspector\bin\$(Configuration)\net8.0-windows\WpfVisualTreeMcp.Inspector.dll"
                         RelativePath="native\x64\coreclr\WpfVisualTreeMcp.Inspector.dll" />
      <_InjectionPayload Include="..\WpfVisualTreeMcp.Inspector\WpfVisualTreeMcp.Inspector.coreclr.runtimeconfig.json"
                         RelativePath="native\x64\coreclr\WpfVisualTreeMcp.Inspector.runtimeconfig.json" />
      <_InjectionPayload Include="..\WpfVisualTreeMcp.Shared\bin\$(Configuration)\net8.0\WpfVisualTreeMcp.Shared.dll"
                         RelativePath="native\x64\coreclr\WpfVisualTreeMcp.Shared.dll" />
      <_InjectionPayload Include="..\WpfVisualTreeMcp.Inspector\bin\$(Configuration)\net8.0-windows\WpfVisualTreeMcp.Inspector.dll"
                         RelativePath="native\x86\coreclr\WpfVisualTreeMcp.Inspector.dll" />
      <_InjectionPayload Include="..\WpfVisualTreeMcp.Inspector\WpfVisualTreeMcp.Inspector.coreclr.runtimeconfig.json"
                         RelativePath="native\x86\coreclr\WpfVisualTreeMcp.Inspector.runtimeconfig.json" />
      <_InjectionPayload Include="..\WpfVisualTreeMcp.Shared\bin\$(Configuration)\net8.0\WpfVisualTreeMcp.Shared.dll"
                         RelativePath="native\x86\coreclr\WpfVisualTreeMcp.Shared.dll" />
    </ItemGroup>

    <Error Condition="'@(_NetFrameworkInspectorPayload)' == ''"
           Text="The .NET Framework Inspector dependency closure is empty. Build WpfVisualTreeMcp.Inspector for $(Configuration)|net48 before publishing or packing." />
    <Error Condition="!Exists('..\WpfVisualTreeMcp.Inspector\bin\$(Configuration)\net48\System.Text.Json.dll')"
           Text="The .NET Framework Inspector dependency closure is incomplete: System.Text.Json.dll was not found." />
    <Error Condition="!Exists('%(_InjectionPayload.Identity)')"
           Text="Injection payload file '%(_InjectionPayload.Identity)' for '%(_InjectionPayload.RelativePath)' was not found." />
  </Target>

  <Target Name="CopyInjectionPayloadToOutput"
          AfterTargets="Build"
          Condition="Exists('..\WpfVisualTreeMcp.Bootstrapper\build\x64\Release\WpfInspectorBootstrapper.dll') And Exists('..\WpfVisualTreeMcp.Bootstrapper\build\Win32\Release\WpfInspectorBootstrapper.dll')"
          DependsOnTargets="CollectInjectionPayload">
    <Copy SourceFiles="@(_InjectionPayload)"
          DestinationFiles="@(_InjectionPayload->'$(TargetDir)%(RelativePath)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="AddInjectionPayloadToPublish"
          BeforeTargets="ComputeFilesToPublish"
          DependsOnTargets="CollectInjectionPayload">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_InjectionPayload)"
                             RelativePath="%(_InjectionPayload.RelativePath)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
