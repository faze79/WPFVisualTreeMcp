<Window x:Class="SampleWpfApp.TouchDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Touch gesture demo" Width="700" Height="550" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock Text="Touch gesture demo" FontSize="24" FontWeight="Bold"/>
        <TextBlock Text="Tap, hold, swipe, pinch or rotate inside the surface." Margin="0,8,0,16"/>
        <Border x:Name="TouchSurface" AutomationProperties.AutomationId="touch.surface" Height="280" Background="#E0F2FE" ClipToBounds="True"
                IsManipulationEnabled="True" ManipulationStarting="Starting" ManipulationDelta="Delta">
            <Grid>
                <Border x:Name="TouchCard" Width="130" Height="90" Background="#0284C7" IsHitTestVisible="False">
                    <TextBlock Text="Touch" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Canvas x:Name="TouchContacts" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <Button x:Name="ResetTouchButton" AutomationProperties.AutomationId="touch.reset" Content="Reset" Click="Reset" HorizontalAlignment="Left" Margin="0,12,0,8"/>
        <TextBlock x:Name="TouchTelemetry" AutomationProperties.AutomationId="touch.telemetry" TextWrapping="Wrap" FontFamily="Consolas"/>
        <TextBlock x:Name="TouchManipulation" AutomationProperties.AutomationId="touch.manipulation" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,6,0,0"/>
    </StackPanel>
</Window>
