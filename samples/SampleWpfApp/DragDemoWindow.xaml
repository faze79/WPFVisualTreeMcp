<Window x:Class="SampleWpfApp.DragDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mouse drag demo" Width="700" Height="550" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock Text="Mouse drag demo" FontSize="24" FontWeight="Bold"/>
        <TextBlock Text="Drag the slider thumb, resize the panels, or drop the blue item." Margin="0,8,0,16"/>
        <Slider x:Name="DragSlider" Minimum="0" Maximum="100" Value="40" Height="30"/>
        <TextBlock x:Name="SliderValue" Text="{Binding Value, ElementName=DragSlider, StringFormat=F1}"/>
        <Grid Height="70" Margin="0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="80"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="80"/>
            </Grid.ColumnDefinitions>
            <Border Background="#E0E7FF"><TextBlock Text="Resize me" Margin="12"/></Border>
            <GridSplitter x:Name="DragSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="#64748B" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
            <Border Grid.Column="2" Background="#E2E8F0"/>
        </Grid>
        <Grid Height="70">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border x:Name="DragSource" Background="#2563EB" Padding="12"
                    MouseLeftButtonDown="SourceDown" MouseMove="SourceMove">
                <TextBlock Text="Drag this item" Foreground="White" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="DropTarget" Grid.Column="2" Background="#DCFCE7" Padding="12"
                    AllowDrop="True" DragOver="TargetDragOver" Drop="TargetDrop">
                <TextBlock x:Name="DropStatus" Text="Drop here" VerticalAlignment="Center"/>
            </Border>
        </Grid>
        <TextBlock Text="Canvas: drag with left, right or middle button" Margin="0,16,0,8"/>
        <Canvas x:Name="DragCanvas" Height="110" Background="#F1F5F9">
            <Border x:Name="DragBox" Width="70" Height="60" Canvas.Left="20" Canvas.Top="20"
                    Background="#F59E0B" MouseDown="BoxDown" MouseMove="BoxMove" MouseUp="BoxUp">
                <TextBlock Text="Move" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Canvas>
        <TextBlock x:Name="DragStatus" Text="Ready" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
