<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <SampleTargetFramework Condition="'$(SampleTargetFramework)' == ''">net48</SampleTargetFramework>
    <TargetFramework>$(SampleTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SampleWpfApp</RootNamespace>
    <AssemblyName>SampleWpfApp</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableInspectorSelfHosting Condition="'$(EnableInspectorSelfHosting)' == ''">true</EnableInspectorSelfHosting>
    <DefineConstants Condition="'$(EnableInspectorSelfHosting)' == 'true'">$(DefineConstants);INSPECTOR_SELF_HOST</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableInspectorSelfHosting)' == 'true'">
    <ProjectReference Include="..\..\src\WpfVisualTreeMcp.Inspector\WpfVisualTreeMcp.Inspector.csproj" />
  </ItemGroup>

</Project>
