<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net472;net48;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <RootNamespace>SampleWpfApp</RootNamespace>
    <AssemblyName>SampleWpfApp</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <EnableSelfHostedInspector Condition="'$(EnableSelfHostedInspector)' == ''">true</EnableSelfHostedInspector>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableSelfHostedInspector)' == 'true'">
    <DefineConstants>$(DefineConstants);SELF_HOSTED_INSPECTOR</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableSelfHostedInspector)' == 'true'">
    <ProjectReference Include="..\..\src\WpfVisualTreeMcp.Inspector\WpfVisualTreeMcp.Inspector.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableSelfHostedInspector)' != 'true'">
    <Compile Remove="SelfHostedInspector.cs" />
  </ItemGroup>

</Project>
